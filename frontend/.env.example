# Optional. Leave this UNSET for both local dev and the Docker deployment:
# the app defaults to a same-origin relative "/api" path, which Vite proxies to
# the backend in dev (see vite.config.ts) and nginx proxies in Docker (see
# nginx.conf). Only set this when the API is served from a DIFFERENT origin
# than the frontend, e.g. a standalone backend host:
#
#   VITE_API_BASE_URL=https://api.your-domain.com/api
#
# Do NOT commit a localhost value into a production build.
# VITE_API_BASE_URL=
